//4
   public static void rev(String str){
    for(int i = str.length()-1; i>=0; i--)
    {
        if (i == str.length()-1)
        { System.out.println(str.substring(i));}
        else
            System.out.println(str.substring(i,i+1));
    
    }
    
    
       
    }
